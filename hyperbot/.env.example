# Copy to .env and fill in. NEVER commit the real .env.

# ---- Account -------------------------------------------------------------
# The address whose positions the bot manages (your Hyperliquid account).
HYPERLIQUID_ACCOUNT_ADDRESS=

# ---- Live trading (LOCK 3 of 3) -----------------------------------------
# Leave EMPTY to run as a simulator. The bot works fully without it: scanning,
# ranking, watching and previewing all run with no key at all.
#
# Use an API WALLET, not your main wallet: Hyperliquid -> Settings -> API.
# An API wallet can trade but CANNOT withdraw, so a leaked key cannot drain you.
# This bot has no withdrawal or transfer code path of any kind.
HYPERLIQUID_PRIVATE_KEY=

# ---- Overrides (optional; config.yaml is the normal place for these) -----
# DRY_RUN=true
# NETWORK=testnet

# ---- Notifications -------------------------------------------------------
# Telegram: talk to @BotFather for a token, then @userinfobot for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=
